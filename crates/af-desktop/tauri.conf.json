{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assurance Forge",
  "version": "0.4.0-dev",
  "identifier": "com.assuranceforge.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Assurance Forge",
        "width": 1400,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../assets/icon.ico", "../../assets/icon.png"]
  }
}
