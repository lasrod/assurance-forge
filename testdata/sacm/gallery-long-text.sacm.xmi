    <argumentElement xmi:type="sacm:Claim" xmi:id="REQ_SYS_BRAKE_CONTROLLER_REDUNDANT_CHANNEL_MONITORING_0001"><name content="RedundantChannelMonitoringDetectsEverySinglePointFaultOfThePrimaryChannel" /><description xmi:id="d_REQ_SYS_BRAKE_CONTROLLER_REDUNDANT_CHANNEL_MONITORING_0001"><content><value lang="en" content="The redundant brake controller channel detects every single-point fault of the primary channel, including stuck-at faults on the wheel speed inputs, corrupted CAN frames, watchdog expiry and loss of supply voltage, and takes over control within the fault tolerant time interval of 50 ms defined in the technical safety concept TSC-BRK-004 revision 7, section 4.3.2." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:ArgumentReasoning" xmi:id="S_ARGUMENT_OVER_EACH_FAULT_CLASS_IDENTIFIED_IN_THE_FMEDA"><name content="ArgumentOverFaultClasses" /><description xmi:id="d_S_ARGUMENT_OVER_EACH_FAULT_CLASS_IDENTIFIED_IN_THE_FMEDA"><content><value lang="en" content="Argument over each fault class identified in the FMEDA of the primary channel." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:Claim" xmi:id="G_STUCK"><name content="StuckAtFaultsDetected" /><description xmi:id="d_G_STUCK"><content><value lang="en" content="Stuck-at faults on the wheel speed inputs are detected." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:Claim" xmi:id="G_CAN"><name content="CorruptedFramesDetected" /><description xmi:id="d_G_CAN"><content><value lang="en" content="Corrupted CAN frames are detected by the end-to-end protection profile." /></content></description></argumentElement>
