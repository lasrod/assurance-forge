        <content>
          <value lang="en" content="Operational design domain definition for the braking function." />
        </content>
      </description>
    </argumentElement>
    <argumentElement xmi:type="sacm:ArtifactReference" xmi:id="ev_1">
      <name content="BrakeFMEAReference" />
      <description xmi:id="generated_8">
        <content>
          <value lang="en" content="Reference to brake system FMEA report." />
