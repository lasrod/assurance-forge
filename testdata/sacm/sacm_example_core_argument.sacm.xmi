    <argumentElement xmi:type="sacm:Claim" xmi:id="cl_sub_2" assertionDeclaration="needsSupport">
      <name content="SubClaim_Verification" />
      <description xmi:id="generated_4">
        <content>
          <value lang="en" content="Verification activities demonstrate braking requirements are satisfied." />
        </content>
      </description>
    </argumentElement>
    <argumentElement xmi:type="sacm:Claim" xmi:id="cl_assumption_1" assertionDeclaration="assumed">
      <name content="Assumption_Environment" />
      <description xmi:id="generated_5">
        <content>
          <value lang="en" content="Road friction remains within the assumed operating envelope." />
        </content>
      </description>
    </argumentElement>
    <argumentElement xmi:type="sacm:ArgumentReasoning" xmi:id="ar_1">
      <name content="Reasoning_ArchitectureAndVerification" />
      <description xmi:id="generated_6">
        <content>
          <value lang="en" content="If the architecture mitigates hazards and verification shows requirements satisfaction, then the top safety claim is supported." />
