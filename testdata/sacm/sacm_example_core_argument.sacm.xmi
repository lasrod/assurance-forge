<sacm:AssuranceCasePackage xmlns:sacm="http://www.omg.org/spec/SACM/20220301" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="acp_vehicle_braking">
  <name content="VehicleBrakingAssuranceCase" />
  <description xmi:id="generated_1">
    <content>
