<?xml version="1.0" encoding="UTF-8"?>
<!-- Gallery fixture: a goal and a strategy with several contexts, assumptions and justifications, and a context shared by two goals. -->
<sacm:AssuranceCasePackage xmlns:sacm="http://www.omg.org/spec/SACM/20220301" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="case_Attachments">
  <name content="Attachments" />
  <argumentPackage xmi:id="argpkg_Attachments">
    <name content="AttachmentsArgument" />
    <argumentElement xmi:type="sacm:Claim" xmi:id="G1"><name content="TopClaim" /><description xmi:id="d_G1"><content><value lang="en" content="The level crossing controller is acceptably safe." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:ArtifactReference" xmi:id="C1"><name content="SystemDefinition" /><description xmi:id="d_C1"><content><value lang="en" content="Controller as defined in SD-12, revision 3." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:ArtifactReference" xmi:id="C2"><name content="OperatingEnvironment" /><description xmi:id="d_C2"><content><value lang="en" content="Single-track rural crossings, line speed up to 120 km/h." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:ArtifactReference" xmi:id="C3"><name content="SafeDefinition" /><description xmi:id="d_C3"><content><value lang="en" content="Acceptably safe: tolerable hazard rate met for every hazard." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:Claim" xmi:id="A1" assertionDeclaration="assumed"><name content="TrainDetection" /><description xmi:id="d_A1"><content><value lang="en" content="Track circuits detect every approaching train." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:Claim" xmi:id="A2" assertionDeclaration="assumed"><name content="Maintenance" /><description xmi:id="d_A2"><content><value lang="en" content="Barriers are maintained to the published schedule." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:Claim" xmi:id="J1" assertionDeclaration="axiomatic"><name content="Standard" /><description xmi:id="d_J1"><content><value lang="en" content="EN 50129 requires a hazard-based argument for SIL 4." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:ArgumentReasoning" xmi:id="S1"><name content="OverHazards" /><description xmi:id="d_S1"><content><value lang="en" content="Argument over each hazard in the hazard log." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:Claim" xmi:id="J2" assertionDeclaration="axiomatic"><name content="LogComplete" /><description xmi:id="d_J2"><content><value lang="en" content="The hazard log was reviewed by an independent assessor." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:ArtifactReference" xmi:id="C4"><name content="HazardLog" /><description xmi:id="d_C4"><content><value lang="en" content="Hazard log HL-3, as baselined on 2026-09-01." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:Claim" xmi:id="A3" assertionDeclaration="assumed"><name content="NoNewHazards" /><description xmi:id="d_A3"><content><value lang="en" content="No hazard has been introduced since the baseline." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:Claim" xmi:id="G2"><name content="BarriersClose" /><description xmi:id="d_G2"><content><value lang="en" content="Barriers close before a train reaches the crossing." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:Claim" xmi:id="G3"><name content="WarningGiven" /><description xmi:id="d_G3"><content><value lang="en" content="Road users are warned before the barriers close." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:ArtifactReference" xmi:id="C5"><name content="WarningTime" /><description xmi:id="d_C5"><content><value lang="en" content="Warning time: at least 27 s before the train arrives." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:ArtifactReference" xmi:id="Sn1"><name content="TimingAnalysis" /><description xmi:id="d_Sn1"><content><value lang="en" content="Timing analysis TA-9." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:ArtifactReference" xmi:id="Sn2"><name content="FieldTrials" /><description xmi:id="d_Sn2"><content><value lang="en" content="Field trials FT-2, 400 closures." /></content></description></argumentElement>
    <argumentElement xmi:type="sacm:AssertedContext" xmi:id="x1" source="C1 C2 C3" target="G1"><name content="x1" /></argumentElement>
    <argumentElement xmi:type="sacm:AssertedContext" xmi:id="x2" source="A1 A2" target="G1"><name content="x2" /></argumentElement>
    <argumentElement xmi:type="sacm:AssertedContext" xmi:id="x3" source="J1" target="G1"><name content="x3" /></argumentElement>
    <argumentElement xmi:type="sacm:AssertedInference" xmi:id="i1" source="G2 G3" target="G1" reasoning="S1"><name content="i1" /></argumentElement>
    <argumentElement xmi:type="sacm:AssertedContext" xmi:id="x4" source="J2 C4 A3" target="S1"><name content="x4" /></argumentElement>
    <argumentElement xmi:type="sacm:AssertedContext" xmi:id="x5" source="C5" target="G2"><name content="x5" /></argumentElement>
    <argumentElement xmi:type="sacm:AssertedContext" xmi:id="x6" source="C5" target="G3"><name content="x6" /></argumentElement>
    <argumentElement xmi:type="sacm:AssertedEvidence" xmi:id="e1" source="Sn1" target="G2"><name content="e1" /></argumentElement>
    <argumentElement xmi:type="sacm:AssertedEvidence" xmi:id="e2" source="Sn2" target="G3"><name content="e2" /></argumentElement>
  </argumentPackage>
</sacm:AssuranceCasePackage>
