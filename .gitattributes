* text=auto eol=lf

# SACM files are compared byte for byte against writer output.
*.xmi text eol=lf
*.sacm text eol=lf
testdata/** text eol=lf

*.png binary
*.ico binary

# Fonts are binary, including those under testdata/ (the rule above would
# convert their line endings and corrupt them).
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
