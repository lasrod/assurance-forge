{
  "name": "assurance-forge-ui",
  "private": true,
  "type": "module",
  "description": "The Assurance Forge interface: React and DATUM, on the core as WebAssembly (browser) or through Tauri (desktop).",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "datum": "node scripts/pack-datum.mjs",
    "wasm": "wasm-pack build ../crates/af-wasm --release --target web --out-dir ../../ui/src/wasm --out-name af_wasm",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "check": "tsc --noEmit && eslint . && vitest run",
    "e2e": "pnpm build:e2e && playwright test",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@datum-ui/charts": "file:vendor/datum/datum-ui-charts.tgz",
    "@datum-ui/css": "file:vendor/datum/datum-ui-css.tgz",
    "@datum-ui/fonts": "file:vendor/datum/datum-ui-fonts.tgz",
    "@datum-ui/quantity": "file:vendor/datum/datum-ui-quantity.tgz",
    "@datum-ui/react": "file:vendor/datum/datum-ui-react.tgz",
    "@datum-ui/tokens": "file:vendor/datum/datum-ui-tokens.tgz",
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@datum-ui/charts": "file:vendor/datum/datum-ui-charts.tgz",
      "@datum-ui/css": "file:vendor/datum/datum-ui-css.tgz",
      "@datum-ui/fonts": "file:vendor/datum/datum-ui-fonts.tgz",
      "@datum-ui/quantity": "file:vendor/datum/datum-ui-quantity.tgz",
      "@datum-ui/react": "file:vendor/datum/datum-ui-react.tgz",
      "@datum-ui/tokens": "file:vendor/datum/datum-ui-tokens.tgz"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
