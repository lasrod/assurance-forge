<?xml version="1.0" encoding="UTF-8"?>
<sacm:AssuranceCasePackage xmlns:sacm="http://www.omg.org/spec/SACM/20220301" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmi:version="2.0" xmi:id="acp_root">
  <name content="Root Case"/>
  <assuranceCasePackage xmi:id="acp_nested">
    <name content="Nested Case"/>
    <argumentPackage xmi:id="argpkg_a" interface="argpkg_a_if">
      <name content="Package A"/>
      <argumentElement xsi:type="sacm:Claim" xmi:id="claim_a">
        <name content="Claim A"/>
      </argumentElement>
    </argumentPackage>
    <argumentPackage xsi:type="sacm:ArgumentPackageInterface" xmi:id="argpkg_a_if" implements="argpkg_a">
      <name content="Package A Interface"/>
    </argumentPackage>
    <argumentPackage xmi:id="argpkg_b">
      <name content="Package B"/>
      <argumentElement xsi:type="sacm:Claim" xmi:id="claim_b">
        <name content="Claim B"/>
      </argumentElement>
      <argumentElement xsi:type="sacm:AssertedContext" xmi:id="ctx_1" source="claim_b" target="claim_a"/>
    </argumentPackage>
    <argumentPackage xsi:type="sacm:ArgumentPackageBinding" xmi:id="argpkg_binding" participantPackage="argpkg_a argpkg_b">
      <name content="A-B Binding"/>
    </argumentPackage>
  </assuranceCasePackage>
</sacm:AssuranceCasePackage>
